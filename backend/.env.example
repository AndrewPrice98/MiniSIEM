# MiniSIEM configuration. All settings are environment variables.
# Locally: run `python -m minisiem create-admin` to write backend/.env (git-ignored).
# Hosted: set these in your provider's environment settings (`create-admin --print`).

# --- Login (required: the API refuses all requests until these are set) ---
MINISIEM_ADMIN_USER=admin
# PBKDF2 hash produced by create-admin. Never put a plain password here.
MINISIEM_ADMIN_PASSWORD_HASH=pbkdf2_sha256:600000:<salt>:<hash>
# At least 32 random characters. Changing it logs everyone out.
MINISIEM_SECRET_KEY=<random>
# HTTPS-only session cookie. Default true; false only for local http://localhost.
MINISIEM_COOKIE_SECURE=false
# Trust X-Forwarded-For for the client IP (only behind a proxy you control).
MINISIEM_TRUST_PROXY=false
# Session length in hours (default 8)
MINISIEM_SESSION_HOURS=8

# --- Storage and limits (optional) ---
# SQLite database file (default: backend/data/minisiem.db)
MINISIEM_DB=data/minisiem.db
# Directory of YAML detection rules (default: backend/rules)
MINISIEM_RULES=rules
# Maximum upload size for POST /api/ingest, in MB (default: 10)
MINISIEM_MAX_UPLOAD_MB=10
